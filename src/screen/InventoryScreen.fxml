<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InventoryController">

   <Label text="Inventory" />

   <TableView fx:id="inventoryTable">
      <columns>
         <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
         <TableColumn fx:id="colProductName" prefWidth="100.0" text="Variant" />
         <TableColumn fx:id="colPackSize" prefWidth="100.0" text="Pack Size" />
         <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock (packs)" />
         <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price (Php)" />
      </columns>
   </TableView>

   <HBox>
      <TextField fx:id="amountField" promptText="Packs to add" />
      <Button text="Restock" onAction="#handleRestock" />
   </HBox>

   <Label fx:id="messageLabel" />

</VBox>