<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
         <padding><Insets bottom="16" left="26" right="26" top="16" /></padding>
         
         <Label text="GGEZ MANAGEMENT SYSTEM">
            <font>
               <Font name="System Bold" size="15.0" />
            </font></Label>
         <Region HBox.hgrow="ALWAYS" />
         <Label text="SIGNED IN AS" />
         <Label fx:id="roleLabel" text="MANAGER" />
         <Button onAction="#handleLogout" text="Log out" />
      </HBox>
  </top>
  
   <left>
      <VBox prefWidth="225" spacing="8" styleClass="sidebar">
         <padding><Insets bottom="20" left="16" right="16" top="25" /></padding>
        
         <Button fx:id="dashboardButton" maxWidth="Infinity" onAction="#openDashboard" text="Dashboard Overview" />
         <Button fx:id="inventoryButton" maxWidth="Infinity" onAction="#openInventory" text="Inventory Management" />
         <Button fx:id="productsButton" maxWidth="Infinity" onAction="#openProducts" text="Product Management" />
         <Separator />
         <Button fx:id="transactionsButton" maxWidth="Infinity" onAction="#openTransactions" text="Cash &amp; Transactions" />
         <Button fx:id="clerkSalesButton" maxWidth="Infinity" onAction="#openClerkSales" text="Clerk Sales" />
      </VBox>
   </left>
   
   <center>
      <StackPane fx:id="mainContent">
         <padding><Insets bottom="32" left="32" right="32" top="28" /></padding>
      </StackPane>
   </center>
</BorderPane>
