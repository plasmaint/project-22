<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1060.0" style="-fx-background-color: #FAF7EC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FFFDF7; -fx-border-color: #E7DEC4; -fx-border-width: 0 0 1.5 0;" styleClass="topbar">
         <padding>
            <Insets bottom="14.0" left="22.0" right="22.0" top="14.0" />
         </padding>

         <Label style="-fx-background-color: #ffcd14; -fx-background-radius: 999; -fx-padding: 3 9 3 9;" text="GGEZ" textFill="#3e2714">
            <font>
               <Font name="System Bold" size="11.5" />
            </font>
         </Label>

         <Label text="Golden Goose EggZ" textFill="#4A341B">
            <font>
               <Font name="Cooper Black" size="24.0" />
            </font>
         </Label>

         <Label text="DATA SYSTEM" textFill="#6d8b37">
            <font>
               <Font name="System Bold" size="10.5" />
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS" />

         <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #E7DEC4; -fx-border-radius: 8; -fx-padding: 6 12 6 12;">
            <Label text="SIGNED IN AS:" textFill="#7A6248">
               <font>
                  <Font name="System Bold" size="10.0" />
               </font>
            </Label>
            <Label fx:id="roleLabel" text="MANAGER" textFill="#3E2714">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </HBox>

         <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="34.0" prefWidth="76.0" style="-fx-background-color: #f0e4d3; -fx-background-radius: 8; -fx-border-color: #45381b; -fx-border-radius: 8; -fx-cursor: hand;" text="LOG OUT" textFill="#896820">
            <font>
               <Font name="System Bold" size="10.0" />
            </font>
         </Button>
      </HBox>
   </top>

   <left>
      <VBox prefWidth="235.0" spacing="8.0" style="-fx-background-color: #FFFDF7; -fx-border-color: #E7DEC4; -fx-border-width: 0 1.5 0 0;" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="14.0" right="14.0" top="20.0" />
         </padding>

         <Label text="NAVIGATION" textFill="#8C7458">
            <font>
               <Font name="System Bold" size="10.5" />
            </font>
            <padding>
               <Insets bottom="4.0" left="6.0" />
            </padding>
         </Label>

         <Button fx:id="dashboardButton" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#openDashboard" prefHeight="38.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #E7DEC4; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 12 0 12; -fx-cursor: hand;" text="Dashboard Overview">
            <font>
               <Font name="System Bold" size="12.5" />
            </font>
         </Button>

         <Button fx:id="inventoryButton" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#openInventory" prefHeight="38.0" style="-fx-background-color: #ffcd14; -fx-background-radius: 8; -fx-text-fill: #2F1D0E; -fx-padding: 0 12 0 12; -fx-cursor: hand;" text="Inventory Management">
            <font>
               <Font name="System Bold" size="12.5" />
            </font>
         </Button>

         <Button fx:id="productsButton" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#openProducts" prefHeight="38.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #E7DEC4; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 12 0 12; -fx-cursor: hand;" text="Product Management">
            <font>
               <Font name="System Bold" size="12.5" />
            </font>
         </Button>

         <Separator opacity="0.7">
            <padding>
               <Insets bottom="4.0" top="4.0" />
            </padding>
         </Separator>

         <Label text="OPERATIONS" textFill="#8C7458">
            <font>
               <Font name="System Bold" size="10.5" />
            </font>
            <padding>
               <Insets bottom="4.0" left="6.0" />
            </padding>
         </Label>

         <Button fx:id="transactionsButton" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#openTransactions" prefHeight="38.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #E7DEC4; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 12 0 12; -fx-cursor: hand;" text="Cash &amp; Transactions">
            <font>
               <Font name="System Bold" size="12.5" />
            </font>
         </Button>

         <Button fx:id="clerkSalesButton" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#openClerkSales" prefHeight="38.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #E7DEC4; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 12 0 12; -fx-cursor: hand;" text="Clerk Sales">
            <font>
               <Font name="System Bold" size="12.5" />
            </font>
         </Button>
      </VBox>
   </left>

   <center>
      <StackPane fx:id="mainContent" style="-fx-background-color: #FAF7EC;">
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="24.0" />
         </padding>
      </StackPane>
   </center>
</BorderPane>
