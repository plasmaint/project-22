<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #FAF7EC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProductController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>

   <!-- Page Header Card -->
   <top>
      <VBox spacing="4.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="16.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="16.0" left="22.0" right="22.0" top="16.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label style="-fx-background-color: #6D8B37; -fx-background-radius: 999; -fx-padding: 3 10 3 10;" text="CATALOG" textFill="#fffdf7">
               <font>
                  <Font name="System Bold" size="10.5" />
               </font>
            </Label>
            <Label text="Product Management" textFill="#4A341B">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="productsUniqueAmount" style="-fx-background-color: #FAF7EC; -fx-background-radius: 999; -fx-border-color: #E7DEC4; -fx-border-radius: 999; -fx-padding: 5 14 5 14;" text="Unique Products: 0" textFill="#3E2714">
               <font>
                  <Font name="System Bold" size="12.5" />
               </font>
            </Label>
         </HBox>

         <Label text="Manage egg product listings, pack sizes, descriptions, and prices." textFill="#7A6248">
            <font>
               <Font size="13.0" />
            </font>
         </Label>
      </VBox>
   </top>

   <!-- Product Catalog Table Card -->
   <center>
      <VBox spacing="10.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
         </padding>

         <Label text="Egg Products Catalog" textFill="#3E2714">
            <font>
               <Font name="System Bold" size="15.0" />
            </font>
         </Label>

         <TableView fx:id="productsTable" onMouseClicked="#handleRowClicked" minHeight="180.0" prefHeight="340.0" prefWidth="760.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 10; -fx-border-color: #DDD0AE; -fx-border-radius: 10; -fx-selection-bar: #FFE680; -fx-selection-bar-non-focused: #FFF0B3;" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="colProductId" prefWidth="95.0" text="Product ID" />
               <TableColumn fx:id="colType" prefWidth="110.0" text="Type" />
               <TableColumn fx:id="colName" prefWidth="130.0" text="Name" />
               <TableColumn fx:id="colDescription" prefWidth="240.0" text="Description" />
               <TableColumn fx:id="colPrice" prefWidth="95.0" text="Price" />
               <TableColumn fx:id="colPackSize" prefWidth="95.0" text="Pack Size" />
            </columns>
         </TableView>
      </VBox>
   </center>

   <!-- Product Actions Card -->
   <bottom>
      <VBox fx:id="productManagementBox" spacing="10.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="16.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="16.0" left="22.0" right="22.0" top="14.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Catalog Actions" textFill="#3E2714">
               <font>
                  <Font name="System Bold" size="14.5" />
               </font>
            </Label>
            <Label fx:id="statusMessageLabel" text="" textFill="#7A6248" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </HBox>

         <Separator style="-fx-opacity: 0.55;" />

         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <ComboBox fx:id="typeComboBox" prefHeight="38.0" prefWidth="130.0" promptText="Egg type" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
            <TextField fx:id="nameField" prefHeight="38.0" prefWidth="150.0" promptText="Name (e.g. Large)" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
            <TextField fx:id="descriptionField" prefHeight="38.0" prefWidth="200.0" promptText="Description" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" HBox.hgrow="ALWAYS" />
            <TextField fx:id="priceField" prefHeight="38.0" prefWidth="100.0" promptText="Price (Php)" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
            <TextField fx:id="packSizeField" prefHeight="38.0" prefWidth="100.0" promptText="Pack size" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button mnemonicParsing="false" onAction="#handleAddNewProduct" prefHeight="38.0" style="-fx-background-color: #ffcd14; -fx-background-radius: 8; -fx-text-fill: #2F1D0E; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Add New Product">
               <font>
                  <Font name="System Bold" size="12.5" />
               </font>
            </Button>

            <Button mnemonicParsing="false" onAction="#handleEditExistingProduct" prefHeight="38.0" style="-fx-background-color: #F3EAD2; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Edit Existing Product">
               <font>
                  <Font name="System Bold" size="12.5" />
               </font>
            </Button>
         </HBox>
      </VBox>
   </bottom>
</BorderPane>