<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <VBox spacing="5">
                <Label fx:id="titleLabel"
                       text="Dashboard"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <Label fx:id="subtitleLabel"
                       text="Dashboard Overview"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Statistics"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <VBox fx:id="statsContainer" spacing="8"/>
            </VBox>

            <VBox fx:id="clerkSection" spacing="10">

                <Label text="Clerk Dashboard"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ComboBox fx:id="clerkSelector"
                          promptText="Select a clerk"
                          prefWidth="200"/>

                <VBox fx:id="clerkStatsContainer" spacing="8"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>