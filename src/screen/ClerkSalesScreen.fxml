<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #FAF7EC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClerkSalesController">
   <content>
      <VBox spacing="18.0" style="-fx-background-color: #FAF7EC;">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="4.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);">
               <padding>
                  <Insets bottom="16.0" left="22.0" right="22.0" top="16.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-background-color: #ffcd14; -fx-background-radius: 999; -fx-padding: 3 10 3 10;" text="SALES" textFill="#2F1D0E">
                           <font>
                              <Font name="System Bold" size="10.5" />
                           </font>
                        </Label>
                        <Label fx:id="titleLabel" text="Clerk Sales" textFill="#4A341B">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Label fx:id="subtitleLabel" text="Process sales and monitor individual clerk sales history." textFill="#7A6248">
                     <font>
                        <Font name="System Italic" size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="12.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);">
               <padding>
                  <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="Clerk Sales History" textFill="#3E2714">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="clerkSelector" prefHeight="34.0" prefWidth="220.0" promptText="Select a clerk" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8;" />
                     </children>
                  </HBox>
                  <Separator style="-fx-opacity: 0.55;" />
                  <TableView fx:id="historyTable" prefHeight="340.0" prefWidth="760.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 10; -fx-border-color: #DDD0AE; -fx-border-radius: 10; -fx-selection-bar: #FFE680; -fx-selection-bar-non-focused: #FFF0B3;">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colSaleId" prefWidth="130.0" text="Sale ID" />
                        <TableColumn fx:id="colSaleDateTime" prefWidth="160.0" text="Date &amp; Time" />
                        <TableColumn fx:id="colSaleTotal" prefWidth="110.0" text="Total" />
                        <TableColumn fx:id="colSaleStatus" prefWidth="120.0" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox fx:id="processSalesSection" spacing="12.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);">
               <padding>
                  <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="Sales Processing" textFill="#3E2714">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Separator style="-fx-opacity: 0.55;" />
                  <TableView fx:id="cartTable" prefHeight="140.0" prefWidth="760.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 10; -fx-border-color: #DDD0AE; -fx-border-radius: 10; -fx-selection-bar: #FFE680; -fx-selection-bar-non-focused: #FFF0B3;">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colCartType" prefWidth="130.0" text="Type" />
                        <TableColumn fx:id="colCartName" prefWidth="160.0" text="Variant" />
                        <TableColumn fx:id="colCartQuantity" prefWidth="120.0" text="Quantity (packs)" />
                        <TableColumn fx:id="colCartPrice" prefWidth="120.0" text="Price (Php)" />
                     </columns>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 10; -fx-border-color: #E7DEC4; -fx-border-radius: 10;">
                     <padding>
                        <Insets bottom="10.0" left="14.0" right="10.0" top="14.0" />
                     </padding>
                     <children>
                     	<Label text="Line Total" textFill="#7A6248">
                     	   <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                     	</Label>
                        <Region HBox.hgrow="ALWAYS" />
                     	<Label fx:id="totalValueLabel" text="0.00" textFill="#3E2714">
                     	   <font>
                              <Font name="System Bold" size="14" />
                           </font>
                     	</Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <ComboBox fx:id="productSelector" prefHeight="34.0" prefWidth="171.0" promptText="Select a product" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8;" />
                        <TextField fx:id="quantityField" prefHeight="38.0" prefWidth="180.0" promptText="Number of packs" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
                        <Button mnemonicParsing="false" onAction="#handleAddToCart" prefHeight="38.0" style="-fx-background-color: #F3EAD2; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Add to Cart">
                           <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleRemoveFromCart" prefHeight="38.0" style="-fx-background-color: #FDECEA; -fx-background-radius: 8; -fx-border-color: #E8B4AE; -fx-border-radius: 8; -fx-text-fill: #9E2A22; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Remove from Cart">
                           <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleCheckoutCart" prefHeight="38.0" style="-fx-background-color: #ffcd14; -fx-background-radius: 8; -fx-text-fill: #2F1D0E; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Checkout">
                           <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <Label fx:id="statusLabel" textFill="#7A6248" wrapText="true">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
