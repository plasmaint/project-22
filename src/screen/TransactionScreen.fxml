<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #FAF7EC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TransactionController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>

   <!-- Page Header Card -->
   <top>
      <VBox spacing="4.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="16.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="16.0" left="22.0" right="22.0" top="16.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label style="-fx-background-color: #ffcd14; -fx-background-radius: 999; -fx-padding: 3 10 3 10;" text="AUDIT" textFill="#2F1D0E">
               <font>
                  <Font name="System Bold" size="10.5" />
               </font>
            </Label>
            <Label text="Cash and Transaction" textFill="#4A341B">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="walletBalanceLabel" style="-fx-background-color: #FAF7EC; -fx-background-radius: 999; -fx-border-color: #E7DEC4; -fx-border-radius: 999; -fx-padding: 5 14 5 14;" text="Wallet Balance: ₱0.00" textFill="#3E2714">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
         </HBox>

         <Label text="Track farm wallet balance, cash-in/cash-out entries, and transaction records." textFill="#7A6248">
            <font>
               <Font size="13.0" />
            </font>
         </Label>
      </VBox>
   </top>

   <!-- Transaction Ledger Table Card -->
   <center>
      <VBox spacing="10.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
         </padding>

         <Label text="Transaction History" textFill="#3E2714">
            <font>
               <Font name="System Bold" size="15.0" />
            </font>
         </Label>

         <TableView fx:id="transactionTable" minHeight="180.0" prefHeight="320.0" prefWidth="760.0" style="-fx-background-color: #FAF7EC; -fx-background-radius: 10; -fx-border-color: #DDD0AE; -fx-border-radius: 10; -fx-selection-bar: #FFE680; -fx-selection-bar-non-focused: #FFF0B3;" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="colTransactionId" prefWidth="120.0" text="Transaction ID" />
               <TableColumn fx:id="colType" prefWidth="110.0" text="Type" />
               <TableColumn fx:id="colAmount" prefWidth="120.0" text="Amount (Php)" />
               <TableColumn fx:id="colRecordedBy" prefWidth="130.0" text="Recorded By" />
               <TableColumn fx:id="colDateTime" prefWidth="160.0" text="Date &amp; Time" />
               <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            </columns>
         </TableView>
      </VBox>
   </center>

   <!-- Cash Flow & Void Controls Card -->
   <bottom>
      <VBox spacing="12.0" style="-fx-background-color: #FFFDF7; -fx-background-radius: 14; -fx-border-color: #E7DEC4; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(74, 52, 27, 0.06), 12, 0, 0, 4);" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="16.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="16.0" left="22.0" right="22.0" top="14.0" />
         </padding>

         <Label text="Record Cash Flow" textFill="#3E2714">
            <font>
               <Font name="System Bold" size="14.5" />
            </font>
         </Label>

         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <ComboBox fx:id="flowTypeComboBox" prefHeight="38.0" prefWidth="165.0" promptText="Cash In / Out" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8;" />
            <TextField fx:id="amountField" prefHeight="38.0" prefWidth="150.0" promptText="Amount (Php)" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" />
            <TextField fx:id="noteField" onAction="#handleRecordCashFlow" prefHeight="38.0" prefWidth="240.0" promptText="Notes" style="-fx-background-color: #FAF7EC; -fx-background-radius: 8; -fx-border-color: #DDD0AE; -fx-border-radius: 8; -fx-text-fill: #3E2714; -fx-prompt-text-fill: #9E8A70; -fx-padding: 0 12 0 12;" HBox.hgrow="ALWAYS" />
            <Button fx:id="recordCashButton" mnemonicParsing="false" onAction="#handleRecordCashFlow" prefHeight="38.0" style="-fx-background-color: #ffcd14; -fx-background-radius: 8; -fx-text-fill: #2F1D0E; -fx-padding: 0 18 0 18; -fx-cursor: hand;" text="Record Flow">
               <font>
                  <Font name="System Bold" size="12.5" />
               </font>
            </Button>
         </HBox>

         <Separator style="-fx-opacity: 0.55;" />

         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Button fx:id="voidTransactionButton" mnemonicParsing="false" onAction="#handleVoidTransaction" prefHeight="36.0" style="-fx-background-color: #FDECEA; -fx-background-radius: 8; -fx-border-color: #E8B4AE; -fx-border-radius: 8; -fx-text-fill: #9E2A22; -fx-padding: 0 16 0 16; -fx-cursor: hand;" text="Void Selected Transaction">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Label fx:id="statusMessageLabel" text="" textFill="#7A6248" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </HBox>
      </VBox>
   </bottom>
</BorderPane>
